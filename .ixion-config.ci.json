{
  "storages": [
    {
      "name": "local",
      "type": "local",
      "config": {
        "rootPath": "./storage",
        "paths": {
          "versions": "versions",
          "ui": "ui"
        }
      }
    },
    {
      "name": "backbone",
      "type": "s3",
      "config": {
        "publicationMode": "cooperative",
        "requestChecksumCalculation": "WHEN_REQUIRED",
        "responseChecksumValidation": "WHEN_REQUIRED",
        "endPoint": "{{ BACKBONE_ENDPOINT }}",
        "port": 443,
        "useSSL": true,
        "accessKey": "{{ BACKBONE_ACCESS_KEY }}",
        "secretKey": "{{ BACKBONE_SECRET_KEY }}",
        "bucketName": "{{ BACKBONE_BUCKET_NAME }}",
        "region": "{{ BACKBONE_REGION }}",
        "prefix": "{{ BACKBONE_PREFIX }}",
        "paths": {
          "versions": "versions",
          "ui": "ui"
        }
      }
    }
  ]
}
