{
  "storages": [
    {
      "name": "local",
      "type": "local",
      "config": {
        "rootPath": "./storage",
        "paths": {
          "versions": "versions",
          "ui": "ui"
        }
      }
    },
    {
      "name": "garage-33",
      "type": "s3",
      "config": {
        "endPoint": "localhost",
        "port": 3900,
        "useSSL": false,
        "accessKey": "replace-with-garage-access-key",
        "secretKey": "replace-with-garage-secret-key",
        "bucketName": "ixion-versions",
        "region": "garage",
        "prefix": "ffxiv",
        "paths": {
          "versions": "versions",
          "ui": "ui"
        }
      }
    }
  ]
}
